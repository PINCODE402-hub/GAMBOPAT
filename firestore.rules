rules_version = '2';
// 1. Replace YOUR-ADMIN-EMAIL@example.com below with the email you log in to the admin page with.
// 2. Paste into Firebase Console > Firestore Database > Rules, then Publish.
// Public can read designs and only bump the views/enquiries counters.
// ONLY your admin email can add, edit or delete designs.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'YOUR-ADMIN-EMAIL@example.com'
        && request.auth.token.email_verified == true;
    }
    match /{collection}/{docId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views','enquiries']);
    }
  }
}
